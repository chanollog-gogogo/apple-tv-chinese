#!name=Apple TV 中文界面（分页修复候选）
#!desc=0.3.0-dev.5：保持零偏好缓存写入；补充分集分页参数；刷新旧英文条件缓存。置于原字幕模块上方，停用旧界面模块。尚待真机验收。
#!version=0.3.0-dev.5
#!author=chanollog-gogogo

[Script]
AppleTV-Full.refresh = type=http-request,engine=jsc,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v[23]\/(?:canvases|shelves|brands|channels|movies|shows|episodes|seasons|search)(?:[\/?]|$),requires-body=0,timeout=5,argument=mode=regional,script-path=https://raw.githubusercontent.com/chanollog-gogogo/apple-tv-chinese/fix-tvos-explicit-jsc/apple-tv-no-prefs-paged.bundle.js?v=0.3.0-dev.5
AppleTV-Full.response = type=http-response,engine=jsc,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v[23]\/(?:canvases|shelves|brands|channels|movies|shows|episodes|seasons|search)(?:[\/?]|$),requires-body=1,max-size=786432,timeout=15,argument=mode=regional,script-path=https://raw.githubusercontent.com/chanollog-gogogo/apple-tv-chinese/fix-tvos-explicit-jsc/apple-tv-no-prefs-paged.bundle.js?v=0.3.0-dev.5

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com
