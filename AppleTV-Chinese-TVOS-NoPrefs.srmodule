#!name=Apple TV 中文界面（无缓存修复候选）
#!desc=0.3.0-dev.4：移除全部脚本偏好缓存读写，修复 tvOS 存储超限终止；保留台、新、港公开资料查询。置于原字幕模块上方，停用旧界面模块。尚待真机验收。
#!version=0.3.0-dev.4
#!author=chanollog-gogogo

[Script]
AppleTV-Full.response = type=http-response,engine=jsc,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v[23]\/(?:canvases|shelves|brands|channels|movies|shows|episodes|seasons|search)(?:[\/?]|$),requires-body=1,max-size=786432,timeout=15,argument=mode=regional,script-path=https://raw.githubusercontent.com/chanollog-gogogo/apple-tv-chinese/fix-tvos-explicit-jsc/apple-tv-no-prefs-subtitles.bundle.js?v=0.3.0-dev.4

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com
