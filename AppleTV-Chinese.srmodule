#!name=Apple TV 中文界面（新加坡）
#!desc=实验版0.1.0：仅将Apple TV内容接口切到新加坡简体中文；不改账户地区，不改播放或字幕地址。内容目录可能随区服变化。请停用原iRingo TV模块。
#!author=chanollog-gogogo
#!version=0.1.0
#!homepage=https://github.com/chanollog-gogogo/apple-tv-chinese

[Script]
AppleTV-Chinese.request = type=http-request,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v[123]\/(configurations|canvases|shelves|brands|channels|movies|shows|episodes|search)(\/|\?|$),script-path=https://raw.githubusercontent.com/chanollog-gogogo/apple-tv-chinese/main/apple-tv-zh.js,timeout=10,argument=region=SG

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com
